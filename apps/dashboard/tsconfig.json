{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    // The dashboard runs in browsers, and Vite serves and bundles it.
    "lib": ["es2024", "dom", "dom.iterable"],
    "types": ["vite/client"],
    "jsx": "react-jsx",
    // shadcn/ui writes its imports from the source root: `@/views/ui/button`.
    "paths": { "@/*": ["./src/*"] }
  },
  "include": ["src", "test", "vite.config.ts", "vitest.config.ts"]
}
