{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "cluenori",
  "main": "src/worker.ts",
  // Raise deliberately, reading the change log of the compatibility flags it turns on.
  "compatibility_date": "2026-10-01",
  // Served at https://cluenori.<your subdomain>.workers.dev until you add a route.
  "workers_dev": true,
  // The dashboard's files, which ./run, ./setup, and ./update build first. Every other path is the
  // dashboard's too, so a page's address opens it; the API, ingest and the files at /.well-known (the
  // iPhone app's association, for passkeys) always reach the Worker.
  "assets": {
    "directory": "../dashboard/dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/otlp/*", "/ingest/*", "/.well-known/*"],
  },
  // One Durable Object per project, named `<workspace>/<project>`, holding its database; and the
  // workspace's own, named `<workspace>`, holding what belongs to the whole workspace.
  "durable_objects": {
    "bindings": [
      { "name": "PROJECT", "class_name": "ProjectObject" },
      { "name": "WORKSPACE", "class_name": "WorkspaceObject" },
    ],
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["ProjectObject"] },
    { "tag": "v2", "new_sqlite_classes": ["WorkspaceObject"] },
  ],
  // Every export, kept 90 days by the bucket's lifecycle rule, which ./setup adds.
  "r2_buckets": [{ "binding": "ARCHIVE", "bucket_name": "cluenori-archive" }],
  // Workers AI, which drafts release notes. It has no local copy: ./run calls the real models, billed
  // to your account, only when a draft is asked for.
  "ai": { "binding": "AI" },
  // Activity, from each project's object to what reacts to it in the workspace's: alerts on phones.
  // ./setup and ./update make the queue. A batch waits at most a second, and one that fails is
  // tried again every 30 seconds, 10 times.
  "queues": {
    "producers": [{ "binding": "ACTIVITY", "queue": "cluenori-activity" }],
    "consumers": [
      {
        "queue": "cluenori-activity",
        "max_batch_size": 100,
        "max_batch_timeout": 1,
        "max_retries": 10,
        "retry_delay": 30,
      },
    ],
  },
  "env": {
    // What ./setup deploys when your data stays in the EU: the same Worker, with its Durable Objects
    // and its archive there. Environments don't inherit bindings, so they are repeated.
    "eu": {
      "name": "cluenori",
      "assets": {
        "directory": "../dashboard/dist",
        "not_found_handling": "single-page-application",
        "run_worker_first": ["/api/*", "/otlp/*", "/ingest/*", "/.well-known/*"],
      },
      "durable_objects": {
        "bindings": [
          { "name": "PROJECT", "class_name": "ProjectObject" },
          { "name": "WORKSPACE", "class_name": "WorkspaceObject" },
        ],
      },
      "r2_buckets": [{ "binding": "ARCHIVE", "bucket_name": "cluenori-archive", "jurisdiction": "eu" }],
      "ai": { "binding": "AI" },
      // The queue is made in the EU; its binding names it alone.
      "queues": {
        "producers": [{ "binding": "ACTIVITY", "queue": "cluenori-activity" }],
        "consumers": [
          {
            "queue": "cluenori-activity",
            "max_batch_size": 100,
            "max_batch_timeout": 1,
            "max_retries": 10,
            "retry_delay": 30,
          },
        ],
      },
      "vars": { "CLUENORI_JURISDICTION": "eu" },
    },
  },
}
