{
  "openapi": "3.1.0",
  "info": {
    "title": "Cluenori",
    "version": "0.0.1"
  },
  "paths": {
    "/api/health": {
      "get": {
        "tags": [
          "system"
        ],
        "operationId": "health",
        "parameters": [],
        "security": [],
        "responses": {
          "204": {
            "description": "<No Content>"
          }
        },
        "description": "Answers 204 when the Worker is deployed and serving. Use it for uptime checks; it reads no storage."
      }
    },
    "/api/projects": {
      "post": {
        "tags": [
          "projects"
        ],
        "operationId": "projects.createProject",
        "parameters": [],
        "security": [
          {
            "bearer": []
          }
        ],
        "responses": {
          "201": {
            "description": "Project",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProjectEncoded"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UnauthorizedEncoded"
                }
              }
            }
          },
          "409": {
            "description": "ProjectExists",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProjectExistsEncoded"
                }
              }
            }
          }
        },
        "description": "Creates a project: one product, with the components that ship separately. Its key is permanent.",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "key": {
                    "type": "string",
                    "maxLength": 40
                  },
                  "name": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 100,
                    "pattern": "^\\S[\\s\\S]*\\S$|^\\S$|^$"
                  }
                },
                "required": [
                  "key",
                  "name"
                ],
                "additionalProperties": false
              }
            }
          },
          "required": true
        }
      }
    },
    "/api/projects/{project}/components": {
      "post": {
        "tags": [
          "projects"
        ],
        "operationId": "projects.addComponent",
        "parameters": [
          {
            "name": "project",
            "in": "path",
            "schema": {
              "type": "string",
              "maxLength": 40
            },
            "required": true
          }
        ],
        "security": [
          {
            "bearer": []
          }
        ],
        "responses": {
          "201": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "component": {
                      "$ref": "#/components/schemas/ComponentEncoded"
                    },
                    "ingestKey": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "component",
                    "ingestKey"
                  ],
                  "additionalProperties": false
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UnauthorizedEncoded"
                }
              }
            }
          },
          "404": {
            "description": "ProjectNotFound",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProjectNotFoundEncoded"
                }
              }
            }
          },
          "409": {
            "description": "ComponentExists",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ComponentExistsEncoded"
                }
              }
            }
          }
        },
        "description": "Adds a component to a project and returns its ingest key, which its telemetry is sent with. The key is shown only in this answer.",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "key": {
                    "type": "string",
                    "maxLength": 40
                  },
                  "name": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 100,
                    "pattern": "^\\S[\\s\\S]*\\S$|^\\S$|^$"
                  }
                },
                "required": [
                  "key",
                  "name"
                ],
                "additionalProperties": false
              }
            }
          },
          "required": true
        }
      }
    },
    "/api/projects/{project}/endpoints": {
      "get": {
        "tags": [
          "signals"
        ],
        "operationId": "signals.endpoints",
        "parameters": [
          {
            "name": "project",
            "in": "path",
            "schema": {
              "type": "string",
              "maxLength": 40
            },
            "required": true
          },
          {
            "name": "from",
            "in": "query",
            "schema": {
              "type": "string"
            },
            "required": true
          },
          {
            "name": "to",
            "in": "query",
            "schema": {
              "type": "string"
            },
            "required": true
          },
          {
            "name": "environment",
            "in": "query",
            "schema": {
              "type": "string",
              "maxLength": 40
            },
            "required": false
          },
          {
            "name": "component",
            "in": "query",
            "schema": {
              "type": "string",
              "maxLength": 40
            },
            "required": false
          }
        ],
        "security": [
          {
            "bearer": []
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "covered": {
                      "$ref": "#/components/schemas/PeriodEncoded"
                    },
                    "rows": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "component": {
                            "type": "string",
                            "maxLength": 40
                          },
                          "environment": {
                            "type": "string",
                            "maxLength": 40
                          },
                          "endpoint": {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 256,
                            "pattern": "^\\S[\\s\\S]*\\S$|^\\S$|^$",
                            "allOf": [
                              {
                                "pattern": "^\\P{Cc}*$"
                              }
                            ]
                          },
                          "requests": {
                            "type": "integer",
                            "minimum": 0,
                            "maximum": 9007199254740991
                          },
                          "errors": {
                            "type": "integer",
                            "minimum": 0,
                            "maximum": 9007199254740991
                          },
                          "averageMs": {
                            "type": "number",
                            "minimum": 0
                          },
                          "p50Ms": {
                            "type": "number",
                            "minimum": 0
                          },
                          "p80Ms": {
                            "type": "number",
                            "minimum": 0
                          },
                          "p95Ms": {
                            "type": "number",
                            "minimum": 0
                          },
                          "p99Ms": {
                            "type": "number",
                            "minimum": 0
                          }
                        },
                        "required": [
                          "component",
                          "endpoint",
                          "requests",
                          "errors",
                          "averageMs",
                          "p50Ms",
                          "p80Ms",
                          "p95Ms",
                          "p99Ms"
                        ],
                        "additionalProperties": false
                      }
                    },
                    "requests": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 9007199254740991
                    },
                    "errors": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 9007199254740991
                    },
                    "dataUntil": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "rows",
                    "requests",
                    "errors"
                  ],
                  "additionalProperties": false
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UnauthorizedEncoded"
                }
              }
            }
          },
          "404": {
            "description": "ProjectNotFound",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProjectNotFoundEncoded"
                }
              }
            }
          }
        },
        "description": "Every endpoint's requests in a period, most requested first: how many, how many failed, and their average, p50, p80, p95 and p99 durations. Counted by the minute for periods of two days or less (kept 14 days), by the hour beyond (kept 15 months); `covered` says which part of the period the counts cover."
      }
    },
    "/api/projects/{project}/requests": {
      "get": {
        "tags": [
          "signals"
        ],
        "operationId": "signals.requests",
        "parameters": [
          {
            "name": "project",
            "in": "path",
            "schema": {
              "type": "string",
              "maxLength": 40
            },
            "required": true
          },
          {
            "name": "from",
            "in": "query",
            "schema": {
              "type": "string"
            },
            "required": true
          },
          {
            "name": "to",
            "in": "query",
            "schema": {
              "type": "string"
            },
            "required": true
          },
          {
            "name": "environment",
            "in": "query",
            "schema": {
              "type": "string",
              "maxLength": 40
            },
            "required": false
          },
          {
            "name": "component",
            "in": "query",
            "schema": {
              "type": "string",
              "maxLength": 40
            },
            "required": false
          },
          {
            "name": "step",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "1m",
                "5m",
                "1h",
                "1d"
              ]
            },
            "required": true
          }
        ],
        "security": [
          {
            "bearer": []
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "covered": {
                      "$ref": "#/components/schemas/PeriodEncoded"
                    },
                    "step": {
                      "type": "string",
                      "enum": [
                        "1m",
                        "5m",
                        "1h",
                        "1d"
                      ]
                    },
                    "points": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "start": {
                            "type": "string"
                          },
                          "requests": {
                            "type": "integer",
                            "minimum": 0,
                            "maximum": 9007199254740991
                          },
                          "errors": {
                            "type": "integer",
                            "minimum": 0,
                            "maximum": 9007199254740991
                          }
                        },
                        "required": [
                          "start",
                          "requests",
                          "errors"
                        ],
                        "additionalProperties": false
                      }
                    }
                  },
                  "required": [
                    "step",
                    "points"
                  ],
                  "additionalProperties": false
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UnauthorizedEncoded"
                }
              }
            }
          },
          "404": {
            "description": "ProjectNotFound",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProjectNotFoundEncoded"
                }
              }
            }
          }
        },
        "description": "Requests and errors over a period, one point per step that has requests: the load on a project's services. A step without a point had no requests reported. Past two days the counts are hourly, so a finer step becomes an hour; `step` says which was used."
      }
    }
  },
  "components": {
    "schemas": {
      "UnauthorizedEncoded": {
        "type": "object",
        "properties": {
          "_tag": {
            "type": "string",
            "enum": [
              "Unauthorized"
            ]
          },
          "message": {
            "type": "string"
          }
        },
        "required": [
          "_tag",
          "message"
        ],
        "additionalProperties": false
      },
      "ProjectNotFoundEncoded": {
        "type": "object",
        "properties": {
          "_tag": {
            "type": "string",
            "enum": [
              "ProjectNotFound"
            ]
          },
          "project": {
            "type": "string",
            "maxLength": 40
          }
        },
        "required": [
          "_tag",
          "project"
        ],
        "additionalProperties": false
      },
      "PeriodEncoded": {
        "type": "object",
        "properties": {
          "from": {
            "type": "string"
          },
          "to": {
            "type": "string"
          }
        },
        "required": [
          "from",
          "to"
        ],
        "additionalProperties": false
      },
      "ComponentExistsEncoded": {
        "type": "object",
        "properties": {
          "_tag": {
            "type": "string",
            "enum": [
              "ComponentExists"
            ]
          },
          "component": {
            "type": "string",
            "maxLength": 40
          }
        },
        "required": [
          "_tag",
          "component"
        ],
        "additionalProperties": false
      },
      "ComponentEncoded": {
        "type": "object",
        "properties": {
          "key": {
            "type": "string",
            "maxLength": 40
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100,
            "pattern": "^\\S[\\s\\S]*\\S$|^\\S$|^$"
          },
          "createdAt": {
            "type": "string"
          }
        },
        "required": [
          "key",
          "name",
          "createdAt"
        ],
        "additionalProperties": false
      },
      "ProjectExistsEncoded": {
        "type": "object",
        "properties": {
          "_tag": {
            "type": "string",
            "enum": [
              "ProjectExists"
            ]
          },
          "project": {
            "type": "string",
            "maxLength": 40
          }
        },
        "required": [
          "_tag",
          "project"
        ],
        "additionalProperties": false
      },
      "ProjectEncoded": {
        "type": "object",
        "properties": {
          "key": {
            "type": "string",
            "maxLength": 40
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100,
            "pattern": "^\\S[\\s\\S]*\\S$|^\\S$|^$"
          },
          "createdAt": {
            "type": "string"
          }
        },
        "required": [
          "key",
          "name",
          "createdAt"
        ],
        "additionalProperties": false
      }
    },
    "securitySchemes": {
      "bearer": {
        "type": "http",
        "scheme": "Bearer"
      }
    }
  },
  "security": [],
  "tags": [
    {
      "name": "system"
    },
    {
      "name": "projects"
    },
    {
      "name": "signals"
    }
  ]
}
