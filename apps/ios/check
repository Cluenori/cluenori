#!/bin/sh
# Checks the iOS app, as `bun run check:ios` does: its Swift's formatting; that the client and screen
# layers import nothing Apple-only, so they build on Linux too; that buttons get closure literals, so
# previews build after an edit; the package's tests, on this Mac; and
# the app built for the iOS Simulator and for iPhones, every warning an error. Needs a Mac with Xcode.
set -eu
cd "$(dirname "$0")"

# The Xcode the app is built with; another can be given in DEVELOPER_DIR.
export DEVELOPER_DIR="${DEVELOPER_DIR:-/Applications/Xcode27.2RC.app/Contents/Developer}"

echo "Checking the Swift's formatting"
xcrun swift format lint --strict --recursive Cluenori CluenoriAlerts Alarms CluenoriApp/Sources CluenoriApp/Tests CluenoriApp/Package.swift

echo "Checking that the client and screen layers stay portable"
apple_only=$(grep -rhE '^import ' CluenoriApp/Sources/CluenoriClient CluenoriApp/Sources/CluenoriScreens \
  | sort -u | grep -vxE 'import (Foundation|FoundationNetworking|Observation|CluenoriClient)' || true)
if [ -n "$apple_only" ]; then
  echo "CluenoriClient and CluenoriScreens may import Foundation, Observation, and CluenoriClient alone, so they"
  echo "build on Linux. Move what needs these into CluenoriViews or the app:"
  echo "$apple_only"
  exit 1
fi

echo "Checking that every Button gets a closure literal"
stored_actions=$(grep -rnE 'Button\(action: [A-Za-z_][A-Za-z0-9_.]*\)' Cluenori CluenoriAlerts Alarms CluenoriApp/Sources || true)
if [ -n "$stored_actions" ]; then
  echo "Write Button(action: { open() }), not Button(action: open): after any edit to its file, Xcode 27.2's"
  echo "previews fail to build the second form (PATTERNS.md, entry 24):"
  echo "$stored_actions"
  exit 1
fi

echo "Testing the package"
xcrun swift test --package-path CluenoriApp --quiet

echo "Building the app for the iOS Simulator and for iPhones"
mkdir -p build
# Builds the app with Xcode, showing what it says but its notes about run destinations, which this
# check doesn't use; fails when the build does.
build_app() {
  status=0
  xcodebuild -project Cluenori.xcodeproj -scheme Cluenori -derivedDataPath build/check -quiet "$@" build \
    > build/check.log 2>&1 || status=$?
  grep -v 'IDERunDestination\|operatingSystemVersion' build/check.log || true
  return $status
}
build_app -destination 'generic/platform=iOS Simulator'
build_app -configuration Release -destination 'generic/platform=iOS' CODE_SIGNING_ALLOWED=NO

echo "The iOS app is in order."
