<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Pairing links from the web: cluenori://pair?url=...&code=... -->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>$(PRODUCT_BUNDLE_IDENTIFIER).pairing</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>cluenori</string>
			</array>
		</dict>
	</array>
	<!-- HTTPS everywhere, except a deployment run with ./run on this Mac or the local network. -->
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>
	<!-- The deployment this build's passkeys sign in to; empty when it has none. -->
	<key>CluenoriPasskeyDomain</key>
	<string>$(CLUENORI_PASSKEY_DOMAIN)</string>
	<!-- The SDK key this build reports itself with, to the deployment above; empty, it reports nothing. -->
	<key>CluenoriSDKKey</key>
	<string>$(CLUENORI_SDK_KEY)</string>
	<key>NSAlarmKitUsageDescription</key>
	<string>Cluenori rings like an alarm clock when a project is down or failing, even in silent mode.</string>
	<key>NSLocalNetworkUsageDescription</key>
	<string>Cluenori connects to a deployment you run on your local network.</string>
</dict>
</plist>
