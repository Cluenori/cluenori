# Copy to Local.env, which git ignores: the ingest key `bun run testflight:ios` has Cluenori number
# each build with, of the app's component in the deployment ./setup saved
# (`./cluenori component ingest-keys <project> <component> --new testflight`).
CLUENORI_INGEST_KEY=cluenori.<project>.<component>.<secret>
