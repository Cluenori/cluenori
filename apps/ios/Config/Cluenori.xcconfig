// The build settings of every target, the app and its alerts' extension, for every configuration;
// each target's own are in App.xcconfig and Alerts.xcconfig. The bundle ID and the team that signs
// the app are each developer's own: copy Local.example.xcconfig to Local.xcconfig, which git ignores.

CLUENORI_BUNDLE_ID = com.example.cluenori
CLUENORI_TEAM =
// The domain of the deployment this app's passkeys sign in to, such as cluenori.example: it must
// serve /.well-known/apple-app-site-association naming this app, as a deployment with push set up
// does. Empty, the app pairs by links alone.
CLUENORI_PASSKEY_DOMAIN =

// Two apps on one iPhone: Release builds are Cluenori, which pairs with the deployment ./setup
// made; Debug builds are Cluenori Local, beside it, which pairs with the one ./run serves. Each has
// its own bundle ID, so its own key, pairing and push token.
CLUENORI_VARIANT_ID =
CLUENORI_VARIANT_ID[config=Debug] = .local
CLUENORI_APP_NAME = Cluenori
CLUENORI_APP_NAME[config=Debug] = Cluenori Local
// Cluenori Local's icon is Cluenori's on the dashboard's light colors, in dark mode too, so the two
// apps look apart at a glance.
CLUENORI_APP_ICON = AppIcon
CLUENORI_APP_ICON[config=Debug] = AppIconLocal

DEVELOPMENT_TEAM = $(CLUENORI_TEAM)
CODE_SIGN_STYLE = Automatic
// The extension's version is the app's, as the App Store requires.
MARKETING_VERSION = 0.1
CURRENT_PROJECT_VERSION = 1

// iPhone only, iOS 27. Simulators on Apple silicon only: packages built for arm64e (the workspace's
// iOSPackagesShouldBuildARM64e) are built for those alone.
EXCLUDED_ARCHS[sdk=iphonesimulator*] = x86_64
SDKROOT = iphoneos
SUPPORTED_PLATFORMS = iphoneos iphonesimulator
TARGETED_DEVICE_FAMILY = 1
IPHONEOS_DEPLOYMENT_TARGET = 27.0

// Each target's Info.plist: the keys Xcode writes, and a file of those it can't.
GENERATE_INFOPLIST_FILE = YES

// Swift 6, on the main actor by default, its warnings errors, as the package's targets are.
SWIFT_VERSION = 6.0
SWIFT_DEFAULT_ACTOR_ISOLATION = MainActor
SWIFT_APPROACHABLE_CONCURRENCY = YES
SWIFT_UPCOMING_FEATURE_EXISTENTIAL_ANY = YES
SWIFT_UPCOMING_FEATURE_MEMBER_IMPORT_VISIBILITY = YES
SWIFT_TREAT_WARNINGS_AS_ERRORS = YES
SWIFT_EMIT_LOC_STRINGS = YES
SWIFT_OPTIMIZATION_LEVEL = -O
SWIFT_OPTIMIZATION_LEVEL[config=Debug] = -Onone
SWIFT_ACTIVE_COMPILATION_CONDITIONS[config=Debug] = DEBUG
SWIFT_COMPILATION_MODE = wholemodule
SWIFT_COMPILATION_MODE[config=Debug] = singlefile
ONLY_ACTIVE_ARCH[config=Debug] = YES
DEBUG_INFORMATION_FORMAT = dwarf-with-dsym
DEBUG_INFORMATION_FORMAT[config=Debug] = dwarf
ENABLE_TESTABILITY[config=Debug] = YES
VALIDATE_PRODUCT[config=Release] = YES

// Apple's hardening: Enhanced Security (pointer authentication, typed allocation, the hardened
// heap; its entitlements are in Cluenori.entitlements), and scripts in a sandbox.
ENABLE_ENHANCED_SECURITY = YES
ENABLE_USER_SCRIPT_SANDBOXING = YES
DEAD_CODE_STRIPPING = YES
// The extension is stripped when it is built; copied into the app, signed, it is left as it is.
COPY_PHASE_STRIP = NO
ALWAYS_SEARCH_USER_PATHS = NO

#include? "Local.xcconfig"
