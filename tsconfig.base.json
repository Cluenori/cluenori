{
  // Every package extends this file and sets only `include` (and `types`, for a host that runs on a
  // platform). Effect's diagnostics come from @effect/tsgo, patched into `tsc` by `bun install`.
  "compilerOptions": {
    "target": "es2024",
    "lib": ["es2024"],
    "module": "preserve",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "skipLibCheck": true,

    // No ambient types unless a package names them: capabilities name none, so Node, Bun, and DOM
    // APIs don't exist for them.
    "types": [],

    "strict": true,
    "exactOptionalPropertyTypes": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "noPropertyAccessFromIndexSignature": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "useUnknownInCatchVariables": true,

    // Erasable syntax only, so every file runs under type stripping and reads the same everywhere.
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "erasableSyntaxOnly": true,
    "forceConsistentCasingInFileNames": true,

    "plugins": [
      {
        "name": "@effect/language-service",
        // Every Effect diagnostic that is on fails the build, suggestions included. A rule we don't
        // follow is turned off below, with its reason.
        "ignoreEffectSuggestionsInTscExitCode": false,
        "ignoreEffectWarningsInTscExitCode": false,
        "ignoreEffectErrorsInTscExitCode": false,
        // Several Effect modules we rely on are marked unstable. Each one is allowed here by name
        // and pinned to one exact version in the catalog, so using a new one is a visible decision.
        "allowedUnstableApis": [
          // Provider-neutral language models, which @bagatka/ai-cloudflare-binding provides on Workers AI.
          "effect/ai",
          "effect/cli",
          "effect/http",
          "effect/http-api",
          "effect/process",
          "effect/sql",
          "effect/Crypto",
          "effect/FileSystem",
          "effect/Path",
          "effect/PlatformError",
          "effect/reactivity",
          "@effect/atom-react",
          // Effect's Crypto on Web Crypto, which Workers have as browsers do.
          "@effect/platform-browser",
          "@effect/platform-bun",
          "@effect/sql-sqlite-do",
          "@effect/vitest"
        ],
        // `import { Effect, Schema } from "effect"`, never "effect/Effect".
        "barrelImportPackages": ["effect"],
        "diagnosticSeverity": {
          // Platform globals: each has an Effect service, so code stays testable and portable.
          "globalDate": "error",
          "globalDateInEffect": "error",
          "globalRandom": "error",
          "globalRandomInEffect": "error",
          "cryptoRandomUUID": "error",
          "cryptoRandomUUIDInEffect": "error",
          "globalFetch": "error",
          "globalFetchInEffect": "error",
          "globalConsole": "error",
          "globalConsoleInEffect": "error",
          "globalTimers": "error",
          "globalTimersInEffect": "error",
          "processEnv": "error",
          "processEnvInEffect": "error",
          "nodeBuiltinImport": "error",
          "abortControllerInEffect": "error",

          // One async model and one error model.
          "asyncFunction": "error",
          "newPromise": "error",
          "tryCatchInEffectGen": "error",
          "extendsNativeError": "error",
          "preferSchemaTaggedError": "error",
          "anyUnknownInErrorContext": "error",
          "unsafeEffectTypeAssertion": "error",

          // Schema decodes untrusted data, inside effects.
          "preferSchemaOverJson": "error",
          "schemaSync": "error",
          "schemaSyncInEffect": "error",
          "instanceOfSchema": "error",
          "preferSchemaTypeProperty": "error",
          "schemaUnionOfLiterals": "error",

          // Services: requirements never leak, layers are provided by hosts, and keys are
          // "<package name>/<file>/<Class>": `@cluenori/features/feature-catalog/FeatureCatalog`.
          "leakingRequirements": "error",
          "deterministicKeys": "error",
          "serviceNotAsClass": "error",
          "strictEffectProvide": "error",

          // One way to write a workflow: generators, no Do notation, no nested generators.
          "effectDoNotation": "error",
          "nestedEffectGenYield": "error",
          "strictBooleanExpressions": "error",
          "preferBarrelImport": "error",

          // Records compare by shape on purpose; IDs and value types carry brands.
          "schemaClassMissingBrand": "off",
          // Records and errors are constructed with `new`, the one way PATTERNS.md shows.
          "newSchemaClass": "off"
        },
        "overrides": [
          {
            // Tests and hosts are where layers are provided (PATTERNS.md, "Services and layers"). The
            // CLI is a host whose every command picks its API target, so it builds clients there.
            "include": ["**/test/**/*.ts", "**/src/main.ts", "**/src/worker.ts", "**/apps/cli/src/**/*.ts"],
            "options": { "diagnosticSeverity": { "strictEffectProvide": "off" } }
          },
          {
            // The typed clients of the whole public API: Effect's client type gives an endpoint without a
            // payload or errors, such as sign-out, a requirement of `[Mode] extends [...] ? never : never`,
            // which is never, and which the diagnostic can't reduce.
            "include": ["**/tests/journeys/test/cluenori-client.ts", "**/apps/dashboard/src/api-client.ts"],
            "options": { "diagnosticSeverity": { "leakingRequirements": "off" } }
          },
          {
            // HTTP middleware runs per request, so its methods need the request, which the API's
            // builder passes in; a cookie credential is read from it.
            "include": ["**/apps/worker/src/member-authorization.ts"],
            "options": { "diagnosticSeverity": { "leakingRequirements": "off" } }
          },
          {
            // The dashboard's tests fail on any error a page logs, which they see by watching `console`.
            "include": ["**/apps/dashboard/test/setup.ts"],
            "options": { "diagnosticSeverity": { "globalConsole": "off" } }
          }
        ]
      }
    ]
  }
}
