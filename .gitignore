node_modules/

# The Workers runtime types and Env, generated by `wrangler types` on install and type check: the
# Worker's, and those of packages whose tests run in workerd
worker-configuration.d.ts

# Wrangler's local state (./run) and build output
.wrangler/

# Local secrets for `wrangler dev`; production secrets live in Wrangler
.dev.vars*

# The dashboard's build: `bun run check` builds it to check its first-load budget
apps/dashboard/dist/

# Screenshots Vitest takes of a browser test that failed
.vitest/

# What a package's mutation testing writes: its reports, and Stryker's working files
.stryker/

# Nix build links
/result
/result-*

# The iOS app: each developer's own bundle ID and team (apps/ios/Config/Local.example.xcconfig),
# the key its builds are numbered with (Local.example.env), and what Xcode and SwiftPM build
apps/ios/Config/Local.xcconfig
apps/ios/Config/Local.env
apps/ios/build/
apps/ios/CluenoriApp/.build/
xcuserdata/

# copies of the repository that agents work in
.claude/worktrees/

# Public URLs Amp writes for services running in an orb
.amp/portals/*
