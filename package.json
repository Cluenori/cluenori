{
  "name": "cluenori",
  "private": true,
  "workspaces": {
    "packages": [
      "packages/*",
      "product/foundation",
      "product/engines/*",
      "product/modules/*",
      "apps/*",
      "sdks/*",
      "tests/*",
      "tools"
    ],
    "catalog": {
      "@bagatka/quantile-sketch": "0.1.0",
      "@base-ui/react": "1.9.0",
      "@cloudflare/vitest-plugin": "1.4.6",
      "@effect/atom-react": "4.0.6",
      "@effect/platform-bun": "4.0.6",
      "@effect/platform-node": "4.0.6",
      "@effect/sql-sqlite-do": "4.0.6",
      "@effect/tsgo": "0.53.5",
      "@effect/vitest": "4.0.6",
      "@fontsource-variable/geist-mono": "5.3.0",
      "@fontsource-variable/inter": "5.3.0",
      "@shadcn/react": "0.3.1",
      "@stryker-mutator/core": "10.1.1",
      "@stryker-mutator/vitest-runner": "10.1.1",
      "@tailwindcss/vite": "4.3.3",
      "@types/react": "19.3.0",
      "@types/react-dom": "19.3.0",
      "@vitejs/plugin-react": "6.1.2",
      "@vitest/browser-playwright": "5.0.5",
      "axe-core": "4.14.0",
      "class-variance-authority": "0.7.1",
      "cmdk": "1.1.1",
      "cn": "0.5.0",
      "effect": "4.0.6",
      "embla-carousel-react": "8.6.0",
      "input-otp": "1.5.0",
      "lucide-react": "1.60.0",
      "oxc-transform-react": "0.155.0",
      "oxfmt": "0.73.0",
      "oxlint": "1.88.0",
      "oxlint-tsgolint": "7.0.2004",
      "playwright": "1.64.1",
      "react": "19.3.1",
      "react-day-picker": "10.0.2",
      "react-dom": "19.3.1",
      "react-resizable-panels": "4.14.7",
      "recharts": "3.8.0",
      "shiki": "4.5.0",
      "tailwindcss": "4.3.3",
      "tw-animate-css": "1.4.0",
      "typescript": "7.0.2",
      "vite": "8.3.4",
      "vitest": "5.0.5",
      "vitest-browser-react": "2.3.0",
      "wrangler": "4.151.3"
    }
  },
  "type": "module",
  "scripts": {
    "postinstall": "effect-tsgo patch && bun run --cwd apps/worker types",
    "check": "bun run typecheck && bun run lint && oxfmt --check && bun tools/src/main.ts check && bun run --cwd apps/dashboard build",
    "check:ios": "apps/ios/check",
    "check:sdk-swift": "sdks/swift/check",
    "testflight:ios": "apps/ios/testflight",
    "typecheck": "bun run --filter '*' typecheck",
    "lint": "oxlint",
    "test": "bun run --cwd apps/dashboard browsers && TZ=Pacific/Chatham LANG=tr_TR.UTF-8 vitest run",
    "format": "oxfmt",
    "generate": "bun tools/src/main.ts generate",
    "generate:apple-models": "bun tools/src/main.ts apple-models"
  },
  "devDependencies": {
    "@effect/tsgo": "catalog:",
    "@stryker-mutator/core": "catalog:",
    "@stryker-mutator/vitest-runner": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "packageManager": "bun@1.4.2"
}
