{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 120,
  "semi": false,
  "singleQuote": false,
  "trailingComma": "all",
  "arrowParens": "always",
  "sortImports": true,
  // Markdown is wrapped by hand at 100 columns; generated files are written by their generators.
  "ignorePatterns": ["**/*.md", "bun.lock", "flake.lock", "**/worker-configuration.d.ts", "**/openapi.json"]
}
