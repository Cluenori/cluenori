{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  // Lints what the compiler and @effect/tsgo don't check. A rule turned off for some files says why
  // next to it; disable comments in code are refused by `bun run check`.
  "options": {
    "typeAware": true,
    "denyWarnings": true,
    "reportUnusedDisableDirectives": "error"
  },
  "plugins": ["eslint", "typescript", "unicorn", "oxc", "import", "react", "jsx-a11y"],
  "categories": {
    "correctness": "error",
    "suspicious": "error",
    "perf": "error"
  },
  "rules": {
    // Explicit over implicit (PATTERNS.md, entry 1).
    "import/no-default-export": "error",
    "typescript/no-explicit-any": "error",
    "typescript/no-non-null-assertion": "error",
    "typescript/consistent-type-assertions": ["error", { "assertionStyle": "never" }],
    "typescript/ban-ts-comment": "error",
    "typescript/consistent-type-imports": "error",
    "typescript/no-namespace": "error",
    "eslint/prefer-const": "error",
    "eslint/no-var": "error",
    "eslint/no-param-reassign": "error",
    "eslint/no-nested-ternary": "error",
    "eslint/eqeqeq": "error",
    // `_tag` is how Effect discriminates Option, Result, Exit, and tagged errors.
    "eslint/no-underscore-dangle": ["error", { "allow": ["_tag"] }],

    // Closed sets are switched over exhaustively, without a default (PATTERNS.md, entry 6).
    "typescript/switch-exhaustiveness-check": "error",
    "typescript/no-misused-promises": "error",

    // Files are lowercase kebab-case, so casing never differs between macOS and Linux.
    "unicorn/filename-case": ["error", { "case": "kebabCase" }],

    // `return yield* new SomeError()` ends a generator that otherwise returns nothing: it is how
    // Effect code fails (PATTERNS.md, "Errors").
    "typescript/consistent-return": "off",

    // React: hooks by their rules, and effects only to sync with something outside React. A value
    // derived from props or state is computed while rendering (PATTERNS.md, "Dashboard views").
    "react/rules-of-hooks": "error",
    "react/exhaustive-deps": "error",
    "react/set-state-in-effect": "error",
    "react/no-deriving-state-in-effects": "error",
    "react/set-state-in-render": "error",
    "react/purity": "error",
    "react/refs": "error",
    "react/immutability": "error",
    "react/static-components": "error",
    "react/no-unstable-nested-components": "error",
    "react/jsx-no-constructed-context-values": "error",
    // JSX compiles with the automatic runtime (`jsx: react-jsx`), which imports what it needs.
    "react/react-in-jsx-scope": "off",
    // A fixed series (hours, chart columns, stack frames, lines of code) is keyed by position,
    // which is its identity; lists of records are keyed by their ID (PATTERNS.md, entry 23).
    "react/no-array-index-key": "off",
    // Data stays immutable (PATTERNS.md, entry 23): a spread in `map` copies one small row, which
    // costs less than a mutation shared by two owners.
    "oxc/no-map-spread": "off",
    // An ARIA role on a div is deliberate where the native element brings behavior or styles that
    // don't fit: a group is not a `fieldset`, a status not an `output`, an image with parts not an `img`.
    "jsx-a11y/prefer-tag-over-role": "off",
    // A scrollable region takes focus, so a keyboard can scroll it (WCAG 2.1.1).
    "jsx-a11y/no-noninteractive-tabindex": ["error", { "roles": ["tabpanel", "region"] }],

    "import/no-cycle": "error",
    "import/no-self-import": "error",

    // Effect 3's packages moved into `effect` in Effect 4 (AGENTS.md, "Effect 4, not Effect 3").
    "eslint/no-restricted-imports": [
      "error",
      {
        "patterns": [
          {
            "group": [
              "@effect/schema",
              "@effect/platform",
              "@effect/sql",
              "@effect/cli",
              "@effect/ai",
              "@effect/rpc",
              "@effect/cluster",
              "@effect/workflow",
              "@effect/experimental"
            ],
            "message": "Effect 4 has these in `effect`: effect/http, effect/sql, effect/cli, effect/ai, effect/rpc."
          }
        ]
      }
    ]
  },
  "overrides": [
    {
      // The web SDK reads Signals for the types of what it sends, never its code, which is the
      // server's and would grow every app's bundle (sdks/web/README.md).
      "files": ["sdks/web/src/**"],
      "rules": {
        "eslint/no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["@effect/schema", "@effect/platform", "@effect/sql", "@effect/cli", "@effect/ai"],
                "message": "Effect 4 has these in `effect`: effect/http, effect/sql, effect/cli, effect/ai."
              },
              {
                "group": ["@cluenori/signals"],
                "allowTypeImports": true,
                "message": "The SDK takes Signals' types alone: `import type`."
              }
            ]
          }
        ]
      }
    },
    {
      // The platforms call these by their default export: Workers call the Worker's entry, and
      // Vitest and Vite read their configuration.
      "files": ["**/src/worker.ts", "**/vitest.config.ts", "**/vitest.*.config.ts", "**/vite.config.ts"],
      "rules": { "import/no-default-export": "off" }
    },
    {
      // The public API's handlers reach a project's object only through MemberProjects, which keeps
      // to the projects the calling member sees.
      "files": ["apps/worker/src/*-handlers.ts"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "paths": [
              {
                "name": "./project-objects.ts",
                "message": "Handlers reach projects through MemberProjects (./member-projects.ts), which keeps to what the member sees."
              }
            ]
          }
        ]
      }
    },
    {
      // Layers inside the dashboard (PATTERNS.md, entry 23). Only `src/project-data.ts` asks the API,
      // so where data comes from is one file; only the design kit shows sample data, though views
      // ahead of the API may use its types.
      "files": ["apps/dashboard/src/**"],
      "rules": {
        "eslint/no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": [
                  "@effect/schema",
                  "@effect/platform",
                  "@effect/sql",
                  "@effect/cli",
                  "@effect/ai",
                  "@effect/rpc",
                  "@effect/cluster",
                  "@effect/workflow",
                  "@effect/experimental"
                ],
                "message": "Effect 4 has these in `effect`: effect/http, effect/sql, effect/cli, effect/ai, effect/rpc."
              },
              {
                "group": ["@/sample/*"],
                "allowTypeImports": true,
                "message": "Sample data is for the design kit; pages ask the API through `@/project-data`."
              },
              { "group": ["@/api-client"], "message": "Ask `@/project-data`: it is the one file that asks the API." }
            ]
          }
        ]
      }
    },
    {
      // Views never import pages.
      "files": ["apps/dashboard/src/views/**"],
      "rules": {
        "eslint/no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": [
                  "@effect/schema",
                  "@effect/platform",
                  "@effect/sql",
                  "@effect/cli",
                  "@effect/ai",
                  "@effect/rpc",
                  "@effect/cluster",
                  "@effect/workflow",
                  "@effect/experimental"
                ],
                "message": "Effect 4 has these in `effect`: effect/http, effect/sql, effect/cli, effect/ai, effect/rpc."
              },
              {
                "group": ["@/sample/*"],
                "allowTypeImports": true,
                "message": "Sample data is for the design kit; pages ask the API through `@/project-data`."
              },
              { "group": ["@/api-client"], "message": "Ask `@/project-data`: it is the one file that asks the API." },
              { "group": ["@/pages/*"], "message": "A view takes data and callbacks; it never imports a page." }
            ]
          }
        ]
      }
    },
    {
      // shadcn's views stay generic: no app code in them.
      "files": ["apps/dashboard/src/views/ui/**"],
      "rules": {
        "eslint/no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": [
                  "@effect/schema",
                  "@effect/platform",
                  "@effect/sql",
                  "@effect/cli",
                  "@effect/ai",
                  "@effect/rpc",
                  "@effect/cluster",
                  "@effect/workflow",
                  "@effect/experimental"
                ],
                "message": "Effect 4 has these in `effect`: effect/http, effect/sql, effect/cli, effect/ai, effect/rpc."
              },
              {
                "group": ["@/sample/*"],
                "allowTypeImports": true,
                "message": "Sample data is for the design kit; pages ask the API through `@/project-data`."
              },
              { "group": ["@/api-client"], "message": "Ask `@/project-data`: it is the one file that asks the API." },
              { "group": ["@/pages/*"], "message": "A view takes data and callbacks; it never imports a page." },
              {
                "group": ["@/views/*", "!@/views/ui/*", "@/project-data", "@/project-facts", "@/router"],
                "message": "shadcn's views are generic: they know nothing of our views, pages, routes, or data."
              }
            ]
          }
        ]
      }
    },
    {
      // The design kit, which shows views on sample data, and the sample itself.
      "files": ["apps/dashboard/src/sample/**", "apps/dashboard/src/pages/kit-*.tsx"],
      "rules": {
        "eslint/no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": [
                  "@effect/schema",
                  "@effect/platform",
                  "@effect/sql",
                  "@effect/cli",
                  "@effect/ai",
                  "@effect/rpc",
                  "@effect/cluster",
                  "@effect/workflow",
                  "@effect/experimental"
                ],
                "message": "Effect 4 has these in `effect`: effect/http, effect/sql, effect/cli, effect/ai, effect/rpc."
              }
            ]
          }
        ]
      }
    },
    {
      // The one file that asks the API.
      "files": ["apps/dashboard/src/project-data.ts"],
      "rules": {
        "eslint/no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": [
                  "@effect/schema",
                  "@effect/platform",
                  "@effect/sql",
                  "@effect/cli",
                  "@effect/ai",
                  "@effect/rpc",
                  "@effect/cluster",
                  "@effect/workflow",
                  "@effect/experimental"
                ],
                "message": "Effect 4 has these in `effect`: effect/http, effect/sql, effect/cli, effect/ai, effect/rpc."
              },
              {
                "group": ["@/sample/*"],
                "allowTypeImports": true,
                "message": "Sample data is for the design kit; pages ask the API through `@/project-data`."
              }
            ]
          }
        ]
      }
    },
    {
      // A generic label: its callers pass `htmlFor`, which the rule can't see through the spread.
      "files": ["apps/dashboard/src/views/ui/label.tsx"],
      "rules": { "jsx-a11y/label-has-associated-control": "off" }
    },
    {
      // A click on an input's addon focuses the input, a pointer shortcut: a keyboard reaches the
      // input directly, so the addon needs no key handler of its own.
      "files": ["apps/dashboard/src/views/ui/input-group.tsx"],
      "rules": {
        "jsx-a11y/click-events-have-key-events": "off",
        "jsx-a11y/no-noninteractive-element-interactions": "off"
      }
    },
    {
      // The dashboard's entry, and its tests' setup, import its stylesheet, which is how Vite bundles CSS.
      "files": ["apps/dashboard/src/main.tsx", "apps/dashboard/test/setup.ts"],
      "rules": { "import/no-unassigned-import": ["error", { "allow": ["**/*.css"] }] }
    }
  ],
  "ignorePatterns": ["**/worker-configuration.d.ts", ".claude/worktrees/**"]
}
