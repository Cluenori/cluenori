{
  "$schema": "../node_modules/wrangler/config-schema.json",
  // The Worker the module's tests run in: one Durable Object with SQLite, the way a project's records
  // are kept.
  "name": "releases-test",
  "main": "test-worker.ts",
  "compatibility_date": "2026-10-01",
  "durable_objects": { "bindings": [{ "name": "PROJECT", "class_name": "TestProject" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["TestProject"] }],
}
